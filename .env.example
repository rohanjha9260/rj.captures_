# Contact Form Configuration
# Replace with your backend API URL, Formspree endpoint (https://formspree.io/f/YOUR_FORM_ID),
# or Web3Forms access key (https://web3forms.com)
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Optional: Web3Forms Access Key
# VITE_WEB3FORMS_KEY=your_web3forms_access_key

# Instagram Behold JSON Feed URL (from https://behold.so)
VITE_INSTAGRAM_FEED_URL=https://feeds.behold.so/YOUR_FEED_ID

# Groq Cloud API Key for Photography AI Assistant (ChatBot)
VITE_GROQ_API_KEY=your_groq_api_key_here
